# =============================================================================
# AZWARI BACKEND SERVER ENVIRONMENT CONFIGURATION
# =============================================================================

PORT=5000

# SUPABASE POSTGRESQL & PRISMA CONNECTION CONFIGURATION
# -----------------------------------------------------------------------------
# Transaction mode (port 6543) used by Prisma Client
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Session mode (port 5432) used for direct migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# SUPABASE BACKEND SERVICE ROLE KEY (Never expose to client/browser)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret"

# SMS ETHIOPIA GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER="sms_ethiopia"
SMS_ETHIOPIA_API_KEY="your-sms-ethiopia-api-key"
SMS_ETHIOPIA_SENDER_ID="Azwari"
SMS_ETHIOPIA_API_URL="https://smsethiopia.com/api/sms/send"

# CHAPA PAYMENT GATEWAY CONFIGURATION (ETB)
# -----------------------------------------------------------------------------
# Secret API key from Chapa Dashboard (e.g. CHASECK_TEST-...)
CHAPA_SECRET_KEY="CHASECK_TEST-your-chapa-secret-key"

# Secret hash configured in Chapa Dashboard -> Webhooks for HMAC-SHA256 signature verification
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret-hash"

# Chapa API v1 Endpoint
CHAPA_BASE_URL="https://api.chapa.co/v1"

# Public webhook callback URL on your backend server
CHAPA_CALLBACK_URL="http://localhost:5000/api/webhooks/chapa"

# Frontend redirect page after customer completes payment
CHAPA_RETURN_URL="http://localhost:3000/merchant/wallet?status=return"

# AZWARI WALLET & COLLATERAL BUSINESS RULES
# -----------------------------------------------------------------------------
# Minimum amount for salesperson commission withdrawal (ETB)
MIN_WITHDRAWAL_ETB=100

# Minimum deposit amount for merchant commission collateral (ETB)
MIN_DEPOSIT_ETB=10

# 'PER_STOCK' (backed by stock * commission) or 'PER_PRODUCT' (backed by 1 * commission)
WALLET_LISTING_COLLATERAL_MODE="PER_STOCK"

# Automatically deactivate listings when merchant wallet drops below 1 unit commission
WALLET_AUTO_PAUSE_ENABLED="true"
